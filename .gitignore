# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# keys, certificates and credential files
*.key
*.p12
*.pfx
*.jks
*.keystore
credentials*.json
service-account*.json
*-service-account.json
.npmrc

# supabase cli local state
supabase/.temp
supabase/.branches

# local database files and dumps (migrations live in prisma/migrations and are kept)
*.sqlite
*.sqlite3
*.db
*.dump
*.backup

# claude code local settings
.claude/settings.local.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# prisma generated client
/src/generated

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local dev logs
dev.log
dev.err.log
*.log