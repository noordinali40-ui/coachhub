// CoachHub Africa — data model
//
// Prisma owns the `public` schema. Supabase Auth owns `auth.users`; we mirror the
// auth user id into `users.id` rather than declaring a cross-schema FK, because
// Prisma migrations must not try to manage the `auth` schema.
//
// Authorization is enforced in the data-access layer (src/lib/dal.ts), since Prisma
// connects as the database owner and therefore bypasses RLS. RLS is still enabled on
// every table by migration so that Supabase's auto-generated PostgREST API cannot be
// used to read this data with the public anon key.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// Prisma 7 moved connection URLs out of the schema: Migrate reads them from
// prisma.config.ts, and the runtime client gets them via the `pg` driver adapter
// (see src/lib/prisma.ts).
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  CLIENT
  COACH
  MODERATOR
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

/// Community = self-declared. Verified = identity/experience checked.
/// Professional = a relevant professional credential has actually been verified.
/// Never set PROFESSIONAL without a checked credential (see spec §24).
enum VerificationLevel {
  COMMUNITY
  VERIFIED
  PROFESSIONAL
}

enum CoachStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum TaskType {
  WORKOUT
  WALK
  RUN
  MEAL
  HYDRATION
  HABIT
  REFLECTION
  MEASUREMENT
  CHECK_IN
}

/// Progress metrics are configurable per program — not every user needs every metric.
enum MetricType {
  WEIGHT_KG
  STEPS
  DISTANCE_KM
  WORKOUTS
  ACTIVE_MINUTES
  WATER_LITRES
  HABIT_DAYS
  CUSTOM
}

enum ChallengeStatus {
  DRAFT
  UPCOMING
  ACTIVE
  ENDED
}

/// Deliberately more than raw performance, so the platform does not only reward
/// people who are already very fit (see spec §12).
enum LeaderboardCategory {
  TOTAL
  CONSISTENCY
  STREAK
  MOST_IMPROVED
  COMPLETION
}

enum CommunityMemberRole {
  MEMBER
  MODERATOR
  OWNER
}

enum PostType {
  UPDATE
  QUESTION
  ACHIEVEMENT
  ANNOUNCEMENT
}

enum MessageType {
  TEXT
  IMAGE
  VOICE
  DOCUMENT
}

enum ProductType {
  COACHING_PLAN
  DIGITAL_PROGRAM
  MEAL_PLAN
  CONSULTATION
  EBOOK
  PHYSICAL
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

/// Provider is a string-backed enum on purpose: the payment tables stay
/// provider-agnostic so M-Pesa / mobile money / card rails can be added
/// without a schema migration to the money tables themselves.
enum PaymentProvider {
  MANUAL
  MPESA
  MOBILE_MONEY
  CARD
  OTHER
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum ReportTargetType {
  USER
  COACH
  POST
  COMMENT
  MESSAGE
  COMMUNITY
  PROGRAM
}

enum ReportStatus {
  OPEN
  REVIEWING
  ACTIONED
  DISMISSED
}

enum NotificationType {
  MESSAGE
  NEW_LESSON
  TASK_REMINDER
  CHALLENGE_UPDATE
  COMMUNITY_COMMENT
  COMMUNITY_LIKE
  ACHIEVEMENT
  STREAK
  ANNOUNCEMENT
  ENROLLMENT
  REVIEW
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id        String        @id @db.Uuid // mirrors auth.users.id
  email     String        @unique
  phone     String?       @unique
  role      Role          @default(CLIENT)
  status    AccountStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  profile           Profile?
  coach             Coach?
  enrollments       Enrollment[]
  progress          Progress[]
  metricEntries     MetricEntry[]
  follows           Follow[]
  communityMembers  CommunityMember[]
  posts             Post[]
  comments          Comment[]
  likes             Like[]
  challengeMembers  ChallengeMember[]
  challengeEntries  ChallengeEntry[]
  leaderboardRows   LeaderboardRow[]
  conversationParts ConversationParticipant[]
  sentMessages      Message[]                 @relation("MessageSender")
  orders            Order[]
  payments          Payment[]
  subscriptions     Subscription[]
  reviews           Review[]
  notifications     Notification[]            @relation("NotificationRecipient")
  actedNotification Notification[]            @relation("NotificationActor")
  reportsFiled      Report[]                  @relation("ReportReporter")
  reportsResolved   Report[]                  @relation("ReportResolver")
  blocksMade        Block[]                   @relation("Blocker")
  blocksReceived    Block[]                   @relation("Blocked")
  coachNotes        CoachNote[]               @relation("CoachNoteSubject")

  @@index([role])
  @@map("users")
}

model Profile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  fullName    String
  avatarUrl   String?
  countryCode String?  @db.Char(2)
  city        String?
  languages   String[] @default([])
  bio         String?
  dateOfBirth DateTime? @db.Date
  /// Category slugs the user picked during onboarding ("what do you want to improve?").
  goals       String[] @default([])
  onboardedAt DateTime?
  /// Opt-in bandwidth saver: skips images/video posters across the app.
  lowDataMode Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([countryCode])
  @@map("profiles")
}

// ---------------------------------------------------------------------------
// Coaches & categories
// ---------------------------------------------------------------------------

model Coach {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String            @unique @db.Uuid
  slug             String            @unique
  headline         String
  bio              String
  coverUrl         String?
  yearsExperience  Int               @default(0)
  verification     VerificationLevel @default(COMMUNITY)
  status           CoachStatus       @default(PENDING)
  /// Free-text credential claims. Displayed as claims, never as platform-verified,
  /// unless `verification` has been raised by an admin after an actual check.
  credentials      String[]          @default([])
  acceptingClients Boolean           @default(true)
  offersOnline     Boolean           @default(true)
  offersInPerson   Boolean           @default(false)
  ratingAvg        Decimal           @default(0) @db.Decimal(3, 2)
  ratingCount      Int               @default(0)
  studentCount     Int               @default(0)
  followerCount    Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories    CoachCategory[]
  programs      Program[]
  communities   Community[]
  challenges    Challenge[]
  products      Product[]
  reviews       Review[]
  orders        Order[]
  subscriptions Subscription[]
  followers     Follow[]
  notes         CoachNote[]

  @@index([status, verification])
  @@index([ratingAvg])
  @@map("coaches")
}

model Category {
  slug        String  @id
  name        String
  emoji       String
  description String
  /// Categories outside the launch set stay `active = false` until the core
  /// coaching engine is proven (see the fitness-first launch recommendation).
  active      Boolean @default(true)
  sortOrder   Int     @default(0)

  coaches  CoachCategory[]
  programs Program[]

  @@index([active, sortOrder])
  @@map("categories")
}

model CoachCategory {
  coachId      String  @db.Uuid
  categorySlug String
  isPrimary    Boolean @default(false)

  coach    Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categorySlug], references: [slug], onDelete: Cascade)

  @@id([coachId, categorySlug])
  @@index([categorySlug])
  @@map("coach_categories")
}

model Follow {
  followerId String   @db.Uuid
  coachId    String   @db.Uuid
  createdAt  DateTime @default(now())

  follower User  @relation(fields: [followerId], references: [id], onDelete: Cascade)
  coach    Coach @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@id([followerId, coachId])
  @@index([coachId])
  @@map("follows")
}

/// Private to the owning coach. Never exposed to the student it describes.
model CoachNote {
  id        String   @id @default(uuid()) @db.Uuid
  coachId   String   @db.Uuid
  studentId String   @db.Uuid
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coach   Coach @relation(fields: [coachId], references: [id], onDelete: Cascade)
  student User  @relation("CoachNoteSubject", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([coachId, studentId])
  @@map("coach_notes")
}

// ---------------------------------------------------------------------------
// Programs
// ---------------------------------------------------------------------------

model Program {
  id              String        @id @default(uuid()) @db.Uuid
  coachId         String        @db.Uuid
  categorySlug    String
  slug            String
  title           String
  summary         String
  description     String
  coverUrl        String?
  durationDays    Int
  difficulty      Difficulty    @default(BEGINNER)
  priceCents      Int           @default(0)
  currency        String        @default("KES") @db.Char(3)
  isFree          Boolean       @default(true)
  status          PublishStatus @default(DRAFT)
  requirements    String[]      @default([])
  outcomes        String[]      @default([])
  /// Metrics this program asks students to track. Drives the student dashboard.
  trackedMetrics  MetricType[]  @default([])
  enrollmentCount Int           @default(0)
  ratingAvg       Decimal       @default(0) @db.Decimal(3, 2)
  ratingCount     Int           @default(0)
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  coach       Coach           @relation(fields: [coachId], references: [id], onDelete: Cascade)
  category    Category        @relation(fields: [categorySlug], references: [slug])
  modules     ProgramModule[]
  tasks       Task[]
  enrollments Enrollment[]
  reviews     Review[]
  orders      Order[]

  @@unique([coachId, slug])
  @@index([status, categorySlug])
  @@index([isFree, priceCents])
  @@index([difficulty])
  @@map("programs")
}

model ProgramModule {
  id        String   @id @default(uuid()) @db.Uuid
  programId String   @db.Uuid
  title     String
  summary   String?
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  program Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@unique([programId, position])
  @@map("program_modules")
}

model Lesson {
  id               String   @id @default(uuid()) @db.Uuid
  moduleId         String   @db.Uuid
  title            String
  body             String
  videoUrl         String?
  imageUrl         String?
  /// 1-based day within the whole program. Drives "today's lesson".
  dayNumber        Int
  position         Int
  estimatedMinutes Int      @default(15)
  /// Whether the lesson may be cached for offline use on the student's device.
  isDownloadable   Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  module ProgramModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  tasks  Task[]

  @@unique([moduleId, position])
  @@index([dayNumber])
  @@map("lessons")
}

model Task {
  id          String     @id @default(uuid()) @db.Uuid
  programId   String     @db.Uuid
  lessonId    String?    @db.Uuid
  title       String
  description String?
  type        TaskType   @default(HABIT)
  dayNumber   Int
  position    Int        @default(0)
  /// Optional quantitative target, e.g. 20 (minutes), 2 (litres).
  targetValue Decimal?   @db.Decimal(10, 2)
  unit        String?
  metric      MetricType?
  required    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  program  Program    @relation(fields: [programId], references: [id], onDelete: Cascade)
  lesson   Lesson?    @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  progress Progress[]

  @@index([programId, dayNumber])
  @@map("tasks")
}

// ---------------------------------------------------------------------------
// Enrollment & progress
// ---------------------------------------------------------------------------

model Enrollment {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  programId      String           @db.Uuid
  status         EnrollmentStatus @default(ACTIVE)
  startedOn      DateTime         @db.Date
  completedAt    DateTime?
  /// Cached rollups so the dashboard does not aggregate on every render.
  currentDay     Int              @default(1)
  completedTasks Int              @default(0)
  totalTasks     Int              @default(0)
  streakDays     Int              @default(0)
  longestStreak  Int              @default(0)
  lastActivityOn DateTime?        @db.Date
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  program       Program       @relation(fields: [programId], references: [id], onDelete: Cascade)
  progress      Progress[]
  metricEntries MetricEntry[]
  review        Review?

  @@unique([userId, programId])
  @@index([programId, status])
  @@index([userId, status])
  @@map("enrollments")
}

/// One row per completed task. The spec's `progress` table.
model Progress {
  id           String   @id @default(uuid()) @db.Uuid
  enrollmentId String   @db.Uuid
  taskId       String   @db.Uuid
  userId       String   @db.Uuid
  completedOn  DateTime @db.Date
  value        Decimal? @db.Decimal(10, 2)
  note         String?
  /// Set when the completion was captured offline and replayed on reconnect.
  syncedAt     DateTime?
  createdAt    DateTime @default(now())

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  task       Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, taskId])
  @@index([userId, completedOn])
  @@map("progress")
}

/// Configurable body/activity metrics (weight, steps, distance...). Separate from
/// `progress` because a metric is a time series, while progress is task completion.
model MetricEntry {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @db.Uuid
  enrollmentId String?    @db.Uuid
  metric       MetricType
  value        Decimal    @db.Decimal(10, 2)
  unit         String
  recordedOn   DateTime   @db.Date
  createdAt    DateTime   @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollment Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  @@unique([userId, metric, recordedOn])
  @@index([enrollmentId, metric])
  @@map("metric_entries")
}

// ---------------------------------------------------------------------------
// Communities
// ---------------------------------------------------------------------------

model Community {
  id          String   @id @default(uuid()) @db.Uuid
  coachId     String   @db.Uuid
  slug        String   @unique
  name        String
  description String
  coverUrl    String?
  isPrivate   Boolean  @default(false)
  memberCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  coach      Coach             @relation(fields: [coachId], references: [id], onDelete: Cascade)
  members    CommunityMember[]
  posts      Post[]
  challenges Challenge[]

  @@index([coachId])
  @@map("communities")
}

model CommunityMember {
  communityId String              @db.Uuid
  userId      String              @db.Uuid
  role        CommunityMemberRole @default(MEMBER)
  joinedAt    DateTime            @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([communityId, userId])
  @@index([userId])
  @@map("community_members")
}

model Post {
  id            String   @id @default(uuid()) @db.Uuid
  communityId   String   @db.Uuid
  authorId      String   @db.Uuid
  type          PostType @default(UPDATE)
  body          String
  imageUrl      String?
  likeCount     Int      @default(0)
  commentCount  Int      @default(0)
  isPinned      Boolean  @default(false)
  hiddenAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  Comment[]
  likes     Like[]

  @@index([communityId, createdAt])
  @@index([authorId])
  @@map("posts")
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @db.Uuid
  authorId  String   @db.Uuid
  body      String
  hiddenAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes  Like[]

  @@index([postId, createdAt])
  @@map("comments")
}

model Like {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  postId    String?  @db.Uuid
  commentId String?  @db.Uuid
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, commentId])
  @@map("likes")
}

// ---------------------------------------------------------------------------
// Challenges & leaderboards
// ---------------------------------------------------------------------------

model Challenge {
  id            String          @id @default(uuid()) @db.Uuid
  coachId       String          @db.Uuid
  communityId   String?         @db.Uuid
  slug          String          @unique
  title         String
  description   String
  coverUrl      String?
  rules         String[]        @default([])
  metric        MetricType
  unit          String
  /// Cumulative target per participant, e.g. 100000 steps.
  goalValue     Decimal         @db.Decimal(12, 2)
  startsOn      DateTime        @db.Date
  endsOn        DateTime        @db.Date
  status        ChallengeStatus @default(UPCOMING)
  isPublic      Boolean         @default(true)
  memberCount   Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  coach       Coach             @relation(fields: [coachId], references: [id], onDelete: Cascade)
  community   Community?        @relation(fields: [communityId], references: [id], onDelete: SetNull)
  members     ChallengeMember[]
  entries     ChallengeEntry[]
  leaderboard LeaderboardRow[]

  @@index([status, startsOn])
  @@map("challenges")
}

model ChallengeMember {
  challengeId String    @db.Uuid
  userId      String    @db.Uuid
  joinedAt    DateTime  @default(now())
  /// Cached rollups, recomputed when an entry is logged.
  totalValue  Decimal   @default(0) @db.Decimal(12, 2)
  activeDays  Int       @default(0)
  bestStreak  Int       @default(0)
  /// Baseline captured at join time, used for the "most improved" board.
  baseline    Decimal?  @db.Decimal(12, 2)
  completedAt DateTime?

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([challengeId, userId])
  @@index([userId])
  @@map("challenge_members")
}

model ChallengeEntry {
  id          String   @id @default(uuid()) @db.Uuid
  challengeId String   @db.Uuid
  userId      String   @db.Uuid
  value       Decimal  @db.Decimal(12, 2)
  recordedOn  DateTime @db.Date
  createdAt   DateTime @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId, recordedOn])
  @@map("challenge_entries")
}

/// Denormalised leaderboard snapshot, one row per (challenge, category, user).
/// Recomputed on entry submission so reads stay a single indexed scan.
model LeaderboardRow {
  id          String              @id @default(uuid()) @db.Uuid
  challengeId String              @db.Uuid
  category    LeaderboardCategory
  userId      String              @db.Uuid
  rank        Int
  score       Decimal             @db.Decimal(12, 2)
  computedAt  DateTime            @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, category, userId])
  @@index([challengeId, category, rank])
  @@map("leaderboards")
}

// ---------------------------------------------------------------------------
// Messaging
// ---------------------------------------------------------------------------

/// 1:1 today. Modelled as a conversation + participants so group threads and
/// call metadata can be added without reshaping `messages`.
model Conversation {
  id            String   @id @default(uuid()) @db.Uuid
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationParticipant {
  conversationId String    @db.Uuid
  userId         String    @db.Uuid
  lastReadAt     DateTime?
  joinedAt       DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @db.Uuid
  senderId       String      @db.Uuid
  type           MessageType @default(TEXT)
  body           String
  attachmentUrl  String?
  /// Voice notes: duration is needed to render the player before download.
  durationSec    Int?
  readAt         DateTime?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// Commerce
// ---------------------------------------------------------------------------

model Product {
  id          String      @id @default(uuid()) @db.Uuid
  coachId     String      @db.Uuid
  type        ProductType
  title       String
  description String
  imageUrl    String?
  priceCents  Int
  currency    String      @default("KES") @db.Char(3)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  coach  Coach   @relation(fields: [coachId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([coachId, isActive])
  @@map("products")
}

model Order {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @db.Uuid
  coachId     String      @db.Uuid
  productId   String?     @db.Uuid
  programId   String?     @db.Uuid
  amountCents Int
  currency    String      @db.Char(3)
  /// Platform take, stored at order time so later rate changes are not retroactive.
  feeCents    Int         @default(0)
  status      OrderStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  coach    Coach     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  product  Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  program  Program?  @relation(fields: [programId], references: [id], onDelete: SetNull)
  payments Payment[]

  @@index([userId, status])
  @@index([coachId, status])
  @@map("orders")
}

model Subscription {
  id               String             @id @default(uuid()) @db.Uuid
  userId           String             @db.Uuid
  coachId          String             @db.Uuid
  planName         String
  priceCents       Int
  currency         String             @db.Char(3)
  interval         BillingInterval    @default(MONTHLY)
  status           SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd DateTime
  cancelledAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  coach    Coach     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@unique([userId, coachId])
  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

/// Provider-agnostic. `providerRef` is whatever the rail calls its transaction id
/// (M-Pesa CheckoutRequestID, card PSP intent id, ...) and `payload` keeps the raw
/// callback for reconciliation without adding provider-specific columns.
model Payment {
  id             String          @id @default(uuid()) @db.Uuid
  userId         String          @db.Uuid
  orderId        String?         @db.Uuid
  subscriptionId String?         @db.Uuid
  provider       PaymentProvider @default(MANUAL)
  providerRef    String?
  amountCents    Int
  currency       String          @db.Char(3)
  status         PaymentStatus   @default(INITIATED)
  payload        Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  order        Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([provider, providerRef])
  @@index([userId, status])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Reviews, notifications, moderation
// ---------------------------------------------------------------------------

model Review {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  coachId      String   @db.Uuid
  programId    String?  @db.Uuid
  /// Enforces "one review per eligible experience" and proves the reviewer
  /// actually took the program.
  enrollmentId String?  @unique @db.Uuid
  rating       Int
  body         String
  hiddenAt     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  coach      Coach       @relation(fields: [coachId], references: [id], onDelete: Cascade)
  program    Program?    @relation(fields: [programId], references: [id], onDelete: SetNull)
  enrollment Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  @@unique([userId, programId])
  @@index([coachId, createdAt])
  @@map("reviews")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  actorId   String?          @db.Uuid
  type      NotificationType
  title     String
  body      String?
  url       String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user  User  @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model Report {
  id             String           @id @default(uuid()) @db.Uuid
  reporterId     String           @db.Uuid
  targetType     ReportTargetType
  targetId       String
  reason         String
  details        String?
  status         ReportStatus     @default(OPEN)
  resolvedById   String?          @db.Uuid
  resolutionNote String?
  resolvedAt     DateTime?
  createdAt      DateTime         @default(now())

  reporter   User  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("reports")
}

model Block {
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}
